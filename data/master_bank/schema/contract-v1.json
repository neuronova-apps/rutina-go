{
  "artifactEnvelope": {
    "required": [
      "catalogVersion",
      "contractVersion",
      "items"
    ],
    "types": {
      "catalogVersion": "semantic-version",
      "contractVersion": "semantic-version",
      "items": "array"
    }
  },
  "artifacts": {
    "achievements.json": {
      "idPattern": "^LOG-[0-9]{3}$",
      "itemType": "gamification",
      "typeValue": "Logro"
    },
    "activities.json": {
      "idPattern": "^ACT-[0-9]{3}$",
      "itemType": "activity"
    },
    "categories.json": {
      "itemType": "category"
    },
    "challenges.json": {
      "idPattern": "^RET-[0-9]{3}$",
      "itemType": "gamification",
      "typeValue": "Reto"
    },
    "reinforcement_messages.json": {
      "idPattern": "^MSG-[0-9]{3}$",
      "itemType": "reinforcementMessage"
    },
    "routine_steps.json": {
      "itemType": "routineStep"
    },
    "routines.json": {
      "idPattern": "^RUT-[0-9]{3}$",
      "itemType": "routine"
    },
    "visual_references.json": {
      "itemType": "visualReference"
    }
  },
  "catalogVersion": "1.0.0",
  "contractVersion": "1.0.0",
