      "PENDING_SELECTION",
      "SELECTED",
      "REVIEWED",
      "APPROVED"
    ],
    "sequenceType": [
      "SIMPLE",
      "COMPLETE",
      "OPTIONAL"
    ],
    "visualSource": [
      "PENDING",
      "ARASAAC",
      "OWN_PHOTO"
    ]
  },
  "itemTypes": {
    "activity": {
      "required": [
        "id",
        "category",
        "name",
